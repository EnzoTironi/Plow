{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zoen-oauth-relay",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "observability": { "enabled": false },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "FLOW_TTL_SECONDS": "900",
    // External / In production, published September 19. Scope verification
    // is pending; Google's warning, user cap and account policies still apply.
    "GOOGLE_AUTH_MODE": "unverified",
    "GOOGLE_ENABLED_CAPABILITIES": "identity,calendar_read,calendar_write,gmail_read,gmail_send,drive_files,drive_read,contacts_read,sheets_read,sheets_write,docs_read,docs_write",
    "GOOGLE_REDIRECT_URI": "https://auth.tryzoen.com/callback"
  },
  "routes": [{ "pattern": "auth.tryzoen.com", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "FLOWS", "class_name": "OAuthFlow" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OAuthFlow"] }],
  "ratelimits": [{
    "name": "CREATE_LIMITER",
    "namespace_id": "7419321",
    "simple": { "limit": 20, "period": 60 }
  }]
}
