# Registered Agent Index id. Keep this value unless you fork a new agent.
AGENT_ID=zoen
TZ=America/Sao_Paulo

# Opcionais. Sem token o Zoen pula aquela fonte (issues/watch).
# Nunca commite valores reais. Copie para .env.

# GitHub (leitura de issues; create/comment só depois do sim)
# GH_TOKEN=
# GITHUB_TOKEN=
# GITHUB_REPO=owner/name

# Linear
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=

# Produção — self-heal no worktree; deploy ainda pede sim
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_PROJECT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
